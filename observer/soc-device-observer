#!/usr/bin/env python3

import grp
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

INTERFACE = "enp0s3"
INVENTORY_FILE = Path("/etc/soc-collector/known_devices.json")
ENV_FILE = Path("/etc/soc-collector/collector.env")
STATE_FILE = Path("/var/lib/soc-collector/device_state.json")
COLLECTOR_URL = "http://127.0.0.1:8000/events"

SENSOR_ID = "soc-wazuh-01"
SOURCE = "vm"
DISCOVERY_METHOD = "arp"

OUI_FILE = "/usr/share/arp-scan/ieee-oui.txt"
MAC_FILE = "/etc/arp-scan/mac-vendor.txt"

MAC_PATTERN = re.compile(
    r"^(\d{1,3}(?:\.\d{1,3}){3})\s+"
    r"(([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})"
    r"(?:\s+(.*))?$"
)


def fail(message):
    print(f"ERRO: {message}", file=sys.stderr)
    raise SystemExit(1)


def utc_now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def load_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"não foi possível ler {path}: {exc}")


def read_token():
    try:
        lines = ENV_FILE.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        fail(f"não foi possível ler {ENV_FILE}: {exc}")

    for line in lines:
        line = line.strip()

        if not line or line.startswith("#") or "=" not in line:
            continue

        name, value = line.split("=", 1)

        if name.strip() == "SOC_COLLECTOR_TOKEN":
            value = value.strip()

            if (
                len(value) >= 2
                and value[0] == value[-1]
                and value[0] in {"'", '"'}
            ):
                value = value[1:-1]

            if value:
                return value

    fail("SOC_COLLECTOR_TOKEN não encontrado")


def run_scan():
    command = [
        "arp-scan",
        f"--interface={INTERFACE}",
        f"--ouifile={OUI_FILE}",
        f"--macfile={MAC_FILE}",
        "--localnet",
    ]

    try:
        result = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except FileNotFoundError:
        fail("arp-scan não está instalado")
    except subprocess.TimeoutExpired:
        fail("arp-scan excedeu 120 segundos")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        fail(f"arp-scan falhou: {detail}")

    devices = {}

    for line in result.stdout.splitlines():
        match = MAC_PATTERN.match(line.strip())

        if not match:
            continue

        ip = match.group(1)
        mac = match.group(2).lower()
        vendor = (match.group(4) or "").strip()

        if not vendor or vendor.startswith("(Unknown"):
            vendor = "unknown"

        devices[mac] = {
            "ip": ip,
            "mac": mac,
            "vendor": vendor,
        }

    if not devices:
        fail("nenhum dispositivo foi extraído do arp-scan")

    return list(devices.values())


def is_private_mac(mac):
    try:
        return bool(int(mac.split(":", 1)[0], 16) & 0x02)
    except (ValueError, IndexError):
        return False


def post_event(token, payload):
    body = json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")

    request = Request(
        COLLECTOR_URL,
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )

    try:
        with urlopen(request, timeout=15) as response:
            response_body = response.read().decode("utf-8")
            status_code = response.status
    except HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        fail(f"collector respondeu HTTP {exc.code}: {detail}")
    except URLError as exc:
        fail(f"não foi possível acessar o collector: {exc}")

    if status_code != 202:
        fail(f"collector respondeu HTTP inesperado: {status_code}")

    try:
        result = json.loads(response_body)
    except json.JSONDecodeError:
        fail("collector retornou uma resposta que não é JSON")

    if result.get("status") != "accepted":
        fail(f"collector não aceitou o evento: {result}")

    return result.get("event_id", "unknown")


def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)

    temporary_path = None

    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=STATE_FILE.parent,
            prefix=".device_state.",
            suffix=".tmp",
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            json.dump(
                state,
                temporary,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        os.chmod(temporary_path, 0o640)
        os.chown(
            temporary_path,
            pwd.getpwnam("root").pw_uid,
            grp.getgrnam("soccollector").gr_gid,
        )
        os.replace(temporary_path, STATE_FILE)

    except (OSError, KeyError) as exc:
        if temporary_path:
            temporary_path.unlink(missing_ok=True)

        fail(f"não foi possível salvar o estado: {exc}")


def main():
    if os.geteuid() != 0:
        fail("execute este observador com sudo")

    inventory = load_json(INVENTORY_FILE)

    if not isinstance(inventory, dict):
        fail("inventário autorizado ausente ou inválido")

    network_id = inventory.get("network_id")
    inventory_devices = inventory.get("devices")

    if not network_id or not isinstance(inventory_devices, list):
        fail("estrutura inválida no inventário autorizado")

    known_by_mac = {}

    for device in inventory_devices:
        if isinstance(device, dict) and device.get("mac"):
            known_by_mac[device["mac"].lower()] = device

    state = load_json(STATE_FILE)

    if state is None:
        state = {
            "schema_version": 1,
            "network_id": network_id,
            "devices": {},
        }

    if (
        state.get("network_id") != network_id
        or not isinstance(state.get("devices"), dict)
    ):
        fail("device_state.json pertence a outra rede ou é inválido")

    token = read_token()
    observed_at = utc_now()
    scan_devices = run_scan()
    state_devices = state["devices"]

    print(
        f"{'IP':<16} {'MAC':<18} "
        f"{'DISPOSITIVO':<24} {'CLASSIFICAÇÃO':<14} EVENT_ID"
    )

    for observed in sorted(
        scan_devices,
        key=lambda item: tuple(int(part) for part in item["ip"].split(".")),
    ):
        mac = observed["mac"]
        ip = observed["ip"]

        known = known_by_mac.get(mac)
        previous = state_devices.get(mac, {})

        classification = "known" if known else "unknown"
        device_name = known.get("name", "unknown") if known else "unknown"
        device_type = known.get("type", "unknown") if known else "unknown"

        first_seen = previous.get("first_seen", observed_at)
        previous_vendor = previous.get("vendor", "unknown")
        vendor = observed["vendor"]

        if vendor == "unknown" and previous_vendor != "unknown":
            vendor = previous_vendor

        private_mac = (
            bool(known.get("private_mac", is_private_mac(mac)))
            if known
            else is_private_mac(mac)
        )

        methods = set(previous.get("discovery_methods", []))
        methods.add(DISCOVERY_METHOD)
        methods = sorted(methods)

        payload = {
            "event_type": "device_observed",
            "sensor_id": SENSOR_ID,
            "network_id": network_id,
            "observed_at": observed_at,
            "source": SOURCE,
            "data": {
                "message": (
                    f"Dispositivo {device_name} observado por ARP "
                    f"em {ip}"
                ),
                "ip": ip,
                "mac": mac,
                "vendor": vendor,
                "device_name": device_name,
                "device_type": device_type,
                "classification": classification,
                "private_mac": private_mac,
                "first_seen": first_seen,
                "last_seen": observed_at,
                "discovery_method": DISCOVERY_METHOD,
            },
        }

        event_id = post_event(token, payload)

        state_devices[mac] = {
            "mac": mac,
            "last_ip": ip,
            "vendor": vendor,
            "device_name": device_name,
            "device_type": device_type,
            "classification": classification,
            "private_mac": private_mac,
            "first_seen": first_seen,
            "last_seen": observed_at,
            "discovery_methods": methods,
        }

        print(
            f"{ip:<16} {mac:<18} "
            f"{device_name:<24} {classification:<14} {event_id}"
        )

    state["updated_at"] = observed_at
    save_state(state)

    print()
    print(f"Observações enviadas: {len(scan_devices)}")
    print(f"Estado atualizado: {STATE_FILE}")


if __name__ == "__main__":
    main()
