<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>


<group name="soc_sensor,android_sensor,heartbeat,">

  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="event_type">^heartbeat$</field>
    <field name="sensor_id">^android-sensor-01$</field>
    <description>Heartbeat recebido do sensor Android: $(sensor_id)</description>
  </rule>

</group>

<group name="soc_sensor,android_sensor,network_discovery,">

  <rule id="100110" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_type" type="pcre2">^network\.host\.status$</field>
    <field name="sensor_id" type="pcre2">^android-sensor-01$</field>
    <description>Evento de descoberta de rede recebido do sensor Android.</description>
  </rule>

  <rule id="100111" level="3">
    <if_sid>100110</if_sid>
    <field name="data.state">^up$</field>
    <description>Host ativo detectado pelo sensor Android: $(message)</description>
    <group>host_up,availability,</group>
  </rule>

  <rule id="100112" level="7">
    <if_sid>100110</if_sid>
    <field name="data.state">^down$</field>
    <description>Host esperado sem resposta: $(message)</description>
    <group>host_down,availability,</group>
  </rule>

</group>


<group name="soc_network,device_discovery,">

  <rule id="100120" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_type">^device_observed$</field>
    <description>SOC network device observation event.</description>
  </rule>

  <rule id="100121" level="8">
    <if_sid>100120</if_sid>
    <field name="data.classification">^unknown$</field>
    <description>Unknown device detected on monitored network: $(data.ip) - $(data.mac)</description>
    <group>network,asset_discovery,unknown_device,</group>
  </rule>

</group>
